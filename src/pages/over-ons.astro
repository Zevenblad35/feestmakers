---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Over Ons — De Feestmakers | Evenementenbureau Nijverdal, Overijssel"
  description="Leer het team achter De Feestmakers kennen. Gevestigd in Nijverdal, Overijssel — wij creëren onvergetelijke evenementen met passie, vakmanschap en creativiteit."
  canonical="https://defeestmakers.nl/over-ons"
>

  <!-- Page header -->
  <section class="page-header">
    <div class="page-header-bg">
      <img
        src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-3-scaled.jpg"
        alt="Team De Feestmakers aan het werk tijdens een evenement in Overijssel"
        loading="eager"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="page-header-content">
      <p class="section-label">Over ons</p>
      <h1 class="display-heading">De creatieve geesten<br/><span class="accent">achter de show</span></h1>
    </div>
  </section>

  <!-- Story -->
  <section class="split">
    <div class="split-image">
      <img
        src="https://defeestmakers.nl/wp-content/uploads/2025/04/Website-e1744874691502.jpg"
        alt="De Feestmakers team in Hellendoorn, Overijssel"
        loading="lazy"
      />
    </div>
    <div class="split-content">
      <p class="section-label">Ons verhaal</p>
      <h2 class="section-title">Elk feest verdient<br/>een verhaal dat klopt</h2>
      <p class="body-text">
        Bij De Feestmakers geloven we dat elk feest een verhaal verdient dat klopt — tot in de kleinste details. Van idee tot uitvoering zorgen wij ervoor dat alles samenkomt in een ervaring die raakt, verrast en verbindt.
      </p>
      <p class="body-text" style="margin-top: 1rem;">
        Vanuit Nijverdal in het hart van Overijssel bedienen we klanten in Twente, de Sallandse regio, Gelderland en ver daarbuiten. Onze roots in de regio, gecombineerd met landelijke ambities, maken ons de ideale partner voor elk type evenement.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="split reverse">
    <div class="split-image">
      <img
        src="https://defeestmakers.nl/wp-content/uploads/2025/11/Feestmakers_14-11-2025_f-80-scaled.jpg"
        alt="Feesttent met dansende gasten en kleurrijke verlichting bij evenement De Feestmakers"
        loading="lazy"
      />
    </div>
    <div class="split-content">
      <p class="section-label">Missie & Visie</p>
      <h2 class="section-title">Onvergetelijke<br/>belevingen creëren</h2>
      <p class="body-text">
        Onze missie is om van elk feest een onvergetelijke beleving te maken die van begin tot eind klopt. We brengen creatieve ideeën tot leven met aandacht voor sfeer, detail en de wensen van onze klanten.
      </p>
      <p class="body-text" style="margin-top: 1rem;">
        Omdat we het meeste in eigen beheer hebben, kunnen we snel schakelen en flexibel inspelen op elke situatie. Zo zorgen we voor hoogwaardige, persoonlijke en verrassende evenementen die raken, verbinden en mooie herinneringen achterlaten.
      </p>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: 4rem;">
        <p class="section-label" style="justify-content: center;">Het team</p>
        <h2 class="section-title">Maak kennis met<br/>De Feestmakers</h2>
      </div>

      <div class="team-grid">
        <div class="team-card reveal">
          <div class="team-card-image">
            <img
              src="https://defeestmakers.nl/wp-content/uploads/2025/11/Lotte-6.png"
              alt="Martijn — eigenaar De Feestmakers, evenementenbureau Nijverdal"
              loading="lazy"
            />
          </div>
          <div class="team-card-name">Martijn</div>
          <div class="team-card-role">Eigenaar</div>
        </div>

        <div class="team-card reveal reveal-delay-1">
          <div class="team-card-image">
            <img
              src="https://defeestmakers.nl/wp-content/uploads/2025/11/Lotte-7.png"
              alt="Lotte — stylist en mede-eigenaar De Feestmakers"
              loading="lazy"
            />
          </div>
          <div class="team-card-name">Lotte</div>
          <div class="team-card-role">Stylist & Mede-eigenaar</div>
        </div>

        <div class="team-card reveal reveal-delay-2">
          <div class="team-card-image">
            <img
              src="https://defeestmakers.nl/wp-content/uploads/2025/11/Lotte-5.png"
              alt="Pascal — technicus bij De Feestmakers"
              loading="lazy"
            />
          </div>
          <div class="team-card-name">Pascal</div>
          <div class="team-card-role">Technicus</div>
        </div>

        <div class="team-card reveal reveal-delay-3">
          <div class="team-card-image">
            <img
              src="https://defeestmakers.nl/wp-content/uploads/2025/11/Lotte-4.png"
              alt="Niek, Gerard en Marcel — team De Feestmakers"
              loading="lazy"
            />
          </div>
          <div class="team-card-name">Niek, Gerard & Marcel</div>
          <div class="team-card-role">Team Feestmakers</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo strip -->
  <div class="photo-grid" style="gap: 4px;">
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-1-scaled.jpg" alt="Festival sfeer met publiek bij De Feestmakers evenement" loading="lazy" />
    </div>
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-2.jpg" alt="Lichtshow tijdens bedrijfsfeest in Overijssel" loading="lazy" />
    </div>
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-4.jpg" alt="DJ-booth setup voor privéfeest in Twente" loading="lazy" />
    </div>
  </div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container reveal" style="position: relative; z-index: 2;">
      <h2 class="display-heading" style="font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 1.5rem;">
        Samen maken we<br/><span class="accent">herinneringen</span>
      </h2>
      <p class="body-text" style="margin: 0 auto 2rem; text-align: center;">
        Benieuwd wat we voor jou kunnen betekenen? Neem contact op of volg ons op Instagram voor inspiratie.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary btn-arrow">Neem contact op</a>
        <a href="https://www.instagram.com/feestmakers/" target="_blank" rel="noopener" class="btn btn-outline btn-arrow">Volg ons op Instagram</a>
      </div>
    </div>
  </section>

</Layout>
