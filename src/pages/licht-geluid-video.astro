---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Licht, Geluid & Video Huren — De Feestmakers | Evenementtechniek Nijverdal, Overijssel & Nederland"
  description="Professioneel licht, geluid en video voor evenementen. De Feestmakers levert complete AV-oplossingen voor festivals, bedrijfsfeesten en events. Gevestigd in Nijverdal, actief door heel Nederland."
  canonical="https://defeestmakers.nl/licht-geluid-video"
>

  <section class="page-header">
    <div class="page-header-bg">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJVJ_20-12-2024_w-11.jpg" alt="Licht geluid en video voor evenementen — De Feestmakers" loading="eager" />
      <div class="hero-overlay"></div>
    </div>
    <div class="page-header-content">
      <p class="section-label">Licht, Geluid & Video</p>
      <h1 class="display-heading">Licht, Geluid<br/><span class="accent">& Video</span></h1>
      <p class="body-text" style="margin-top: 1rem;">Professionele AV-techniek die jouw event tot leven brengt. Van sfeervolle verlichting tot krachtige geluidssystemen.</p>
    </div>
  </section>

  <section class="split">
    <div class="split-image">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-2.jpg" alt="Professionele lichtshow bij festival Overijssel" loading="lazy" />
    </div>
    <div class="split-content">
      <p class="section-label">Audiovisuele techniek</p>
      <h2 class="section-title">Techniek met<br/>gevoel voor sfeer</h2>
      <p class="body-text">
        Goed licht en geluid zijn onmisbaar voor een geslaagd evenement. Bij De Feestmakers combineren we technische expertise met creatief inzicht. We leveren niet alleen apparatuur — we ontwerpen een complete licht- en geluidsbeleving die past bij jouw event.
      </p>
      <p class="body-text" style="margin-top: 1rem;">
        Met eigen materiaal en ervaren technici verzorgen we de complete AV-productie voor festivals, bedrijfsfeesten en privéfeesten in Nijverdal, Twente, Overijssel en door heel Nederland.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="dienst-features reveal" style="max-width: 100%;">
        <div class="dienst-feature">
          <div class="dienst-feature-icon">💡</div>
          <h4>Lichtontwerp</h4>
          <p>Van moving heads en wash-lichten tot LED-strips en sfeerverlichting. Wij ontwerpen lichtshows die emotie creëren — van intiem warm tot energiek en dynamisch.</p>
        </div>
        <div class="dienst-feature">
          <div class="dienst-feature-icon">🔊</div>
          <h4>Geluidssystemen</h4>
          <p>Line arrays, monitor-systemen en DJ-setups op maat. Van 50 tot 5.000 bezoekers — wij leveren het juiste systeem met kristalhelder geluid.</p>
        </div>
        <div class="dienst-feature">
          <div class="dienst-feature-icon">📺</div>
          <h4>LED-schermen & Video</h4>
          <p>LED-walls, projectie en live video voor presentaties, visuals en branding. Perfect voor festivals en corporate events.</p>
        </div>
        <div class="dienst-feature">
          <div class="dienst-feature-icon">🎛️</div>
          <h4>Bediening & Crew</h4>
          <p>Onze ervaren technici bedienen alle apparatuur live. Opbouw, soundcheck, show en afbouw — alles professioneel verzorgd.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="photo-grid" style="gap: 4px;">
    <div class="photo-grid-item"><img src="https://defeestmakers.nl/wp-content/uploads/2025/04/NachtVanNijverdal_2017_ToiToi-30-scaled.jpg" alt="Lichtshow Nacht van Nijverdal" loading="lazy" /></div>
    <div class="photo-grid-item"><img src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJVoorJou_ZwarteCross_21-07-2024_w-078.jpg" alt="Geluid DJ festival" loading="lazy" /></div>
    <div class="photo-grid-item"><img src="https://defeestmakers.nl/wp-content/uploads/2025/08/ZwarteCross_19-07-2025_w-71.jpg" alt="Festival AV-techniek" loading="lazy" /></div>
  </div>

  <section class="cta-section">
    <div class="container reveal" style="position: relative; z-index: 2;">
      <h2 class="display-heading" style="font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 1.5rem;">Licht en geluid<br/><span class="accent">op topniveau</span></h2>
      <p class="body-text" style="margin: 0 auto 2rem; text-align: center;">Vraag vrijblijvend een offerte aan voor licht, geluid en video op jouw event.</p>
      <a href="/contact" class="btn btn-primary btn-arrow">Offerte aanvragen</a>
    </div>
  </section>

</Layout>
