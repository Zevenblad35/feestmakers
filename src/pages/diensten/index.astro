---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Diensten — De Feestmakers | Concept, Design & Technische Productie Overijssel"
  description="Van conceptontwikkeling en event design tot technische productie — De Feestmakers biedt alles onder één dak. Evenementenbureau in Nijverdal voor heel Overijssel en Nederland."
  canonical="https://defeestmakers.nl/diensten"
>

  <section class="page-header">
    <div class="page-header-bg">
      <img
        src="https://defeestmakers.nl/wp-content/uploads/2025/04/NachtVanNijverdal_2017_ToiToi-30-scaled.jpg"
        alt="Nacht van Nijverdal festival — evenement geproduceerd door De Feestmakers"
        loading="eager"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="page-header-content">
      <p class="section-label">Onze diensten</p>
      <h1 class="display-heading">Creatie, organisatie &<br/><span class="accent">productie</span> onder één dak</h1>
    </div>
  </section>

  <!-- Services overview -->
  <section class="section">
    <div class="container">
      <div class="reveal" style="max-width: 700px; margin-bottom: 4rem;">
        <p class="body-text" style="font-size: 1.15rem;">
          Bij De Feestmakers combineren we creativiteit met vakmanschap. Of je nu een festival in Twente plant, een bedrijfsevenement in Deventer organiseert of een privéfeest in Salland wilt vieren — wij regelen alles van concept tot en met de technische uitvoering.
        </p>
      </div>

      <div class="services-grid">
        <a href="/diensten/concept-ontwikkeling" class="service-card reveal" style="aspect-ratio: 2/3;">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJvoorJou_08-07-2023_Daarlerveen-013-3.jpg"
            alt="Concept ontwikkeling voor festivals en evenementen door De Feestmakers"
            loading="lazy"
          />
          <div class="service-card-overlay"></div>
          <div class="service-card-content">
            <div class="service-card-title">Concept Ontwikkeling</div>
            <p class="service-card-desc">Van blanco pagina tot bruisend concept. Wij bedenken thema's, storytelling en creatieve invalshoeken die écht bij jou passen.</p>
          </div>
        </a>

        <a href="/diensten/event-design" class="service-card reveal reveal-delay-1" style="aspect-ratio: 2/3;">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2025/08/Carnaval_Nijverdal_22-02-2025_w-120.jpg"
            alt="Event design en sfeervolle decoratie door De Feestmakers Nijverdal"
            loading="lazy"
          />
          <div class="service-card-overlay"></div>
          <div class="service-card-content">
            <div class="service-card-title">Event Design</div>
            <p class="service-card-desc">Sfeer, decor, licht en routing ontworpen als één kloppend verhaal. Van moodboard tot 3D-visual en realisatie.</p>
          </div>
        </a>

        <a href="/diensten/technische-productie" class="service-card reveal reveal-delay-2" style="aspect-ratio: 2/3;">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2025/08/PaasweekendMarle_19-04-2025_w-15-2.jpg"
            alt="Technische productie met licht en geluid door De Feestmakers"
            loading="lazy"
          />
          <div class="service-card-overlay"></div>
          <div class="service-card-content">
            <div class="service-card-title">Technische Productie</div>
            <p class="service-card-desc">Licht, geluid, stroom en podium — veilig, betrouwbaar en tot in de puntjes geregeld.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Photo strip -->
  <div class="photo-grid" style="gap: 4px;">
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/DeventerZiekenhuis_17-11-2023_web2-044-3-e1744884388521.jpg" alt="Evenement productie Deventer Ziekenhuis door De Feestmakers" loading="lazy" />
    </div>
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJVJ_20-12-2024_w-11.jpg" alt="DJ entertainment bij feest in Overijssel" loading="lazy" />
    </div>
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJVoorJou_ZwarteCross_21-07-2024_w-078.jpg" alt="DJ Voor Jou op Zwarte Cross festival" loading="lazy" />
    </div>
  </div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container reveal" style="position: relative; z-index: 2;">
      <h2 class="display-heading" style="font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 1.5rem;">
        Welk event mogen<br/><span class="accent">wij voor jou maken?</span>
      </h2>
      <p class="body-text" style="margin: 0 auto 2rem; text-align: center;">
        Vertel ons over jouw idee en wij maken het werkelijkheid. Van Nijverdal tot Amsterdam — wij komen graag naar je toe.
      </p>
      <a href="/contact" class="btn btn-primary btn-arrow">Vrijblijvend gesprek</a>
    </div>
  </section>

</Layout>
