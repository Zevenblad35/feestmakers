---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Portfolio — De Feestmakers | Onze Evenementen en Projecten in Overijssel"
  description="Bekijk het portfolio van De Feestmakers: festivals, bedrijfsfeesten en privéfeesten in Nijverdal, Twente en heel Overijssel. Laat je inspireren door onze projecten."
  canonical="https://defeestmakers.nl/portfolio"
>

  <section class="page-header">
    <div class="page-header-bg">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/08/ZwarteCross_19-07-2025_w-71.jpg" alt="Festival productie portfolio De Feestmakers — Zwarte Cross" loading="eager" />
      <div class="hero-overlay"></div>
    </div>
    <div class="page-header-content">
      <p class="section-label">Ons werk</p>
      <h1 class="display-heading">Port<span class="accent">folio</span></h1>
      <p class="body-text" style="margin-top: 1rem;">Benieuwd naar wat we allemaal gerealiseerd hebben? Elk project vertelt zijn eigen verhaal — misschien zit jouw idee er straks ook tussen.</p>
    </div>
  </section>

  <!-- Video showcase -->
  <section class="section" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="reveal" style="max-width: 1000px; margin: 0 auto;">
        <div class="video-wrapper">
          <iframe
            src="https://player.vimeo.com/video/1074861051?title=0&byline=0&portrait=0&badge=0&autopause=0&player_id=0&app_id=58479"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            title="De Feestmakers showreel — evenementenbureau Nijverdal"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Masonry gallery -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="portfolio-grid reveal">
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/06/Sonnema.png" alt="Sonnema brand activatie Zwarte Cross — De Feestmakers portfolio" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/DeventerZiekenhuis_17-11-2023_web2-154-e1744884528843.jpg" alt="Stijlvol bedrijfsevenement Deventer Ziekenhuis" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/06/Zwarte-Cross-Feestmakers.png" alt="De Feestmakers op Zwarte Cross festival Lichtenvoorde" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-3-scaled.jpg" alt="Festival sfeer met lichtshow en publiek" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/06/Chocomel-Feestmakers.png" alt="Chocomel activatie door De Feestmakers" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-1-scaled.jpg" alt="DJ entertainment op festival in Overijssel" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/07/deventer-ziekenhuis.png" alt="Personeelsfeest Deventer Ziekenhuis" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/NachtVanNijverdal_2017_ToiToi-30-scaled.jpg" alt="Nacht van Nijverdal festival productie" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/08/ZwarteCross_19-07-2025_w-71.jpg" alt="Zwarte Cross 2025 festival productie De Feestmakers" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/DeventerZiekenhuis_17-11-2023_web2-044-3-e1744884388521.jpg" alt="Evenement styling en techniek Deventer" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/11/Feestmakers_14-11-2025_f-80-scaled.jpg" alt="Feesttent decoratie en verlichting evenement" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJVoorJou_ZwarteCross_21-07-2024_w-078.jpg" alt="DJ Voor Jou op Zwarte Cross 2024" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-4.jpg" alt="Professionele licht- en geluidsopstelling privéfeest" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/08/Carnaval_Nijverdal_22-02-2025_w-120.jpg" alt="Carnaval Nijverdal evenement decoratie" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/05/DJVJ_20-12-2024_w-11.jpg" alt="DJ-show met spectaculaire lichteffecten" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/Website-e1744874691502.jpg" alt="Evenement locatie Hellendoorn De Feestmakers" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-2.jpg" alt="Sfeervolle festivalverlichting evenement Overijssel" loading="lazy" />
        </div>
        <div class="portfolio-item">
          <img src="https://defeestmakers.nl/wp-content/uploads/2025/08/PaasweekendMarle_19-04-2025_w-15-2.jpg" alt="Paasweekend Marle tentfeest productie" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container reveal" style="position: relative; z-index: 2;">
      <h2 class="display-heading" style="font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 1.5rem;">
        Jouw project<br/><span class="accent">hiertussen?</span>
      </h2>
      <p class="body-text" style="margin: 0 auto 2rem; text-align: center;">
        Neem contact op en vertel ons over jouw idee. Wij maken er iets onvergetelijks van.
      </p>
      <a href="/contact" class="btn btn-primary btn-arrow">Start jouw project</a>
    </div>
  </section>

</Layout>
