---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Relaties — De Feestmakers | Onze Opdrachtgevers en Partners in Overijssel"
  description="Bekijk de relaties en opdrachtgevers van De Feestmakers. Van Zwarte Cross en Deventer Ziekenhuis tot lokale ondernemers — wij werken met trots voor deze organisaties."
  canonical="https://defeestmakers.nl/relaties"
>

  <section class="page-header">
    <div class="page-header-bg">
      <img
        src="https://defeestmakers.nl/wp-content/uploads/2025/04/home-footer-3-scaled.jpg"
        alt="Evenementen en samenwerkingen De Feestmakers — relaties en opdrachtgevers"
        loading="eager"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="page-header-content">
      <p class="section-label">Onze relaties</p>
      <h1 class="display-heading">Waar we met trots<br/><span class="accent">voor werken</span></h1>
      <p class="body-text" style="margin-top: 1rem;">
        Van grote festivals tot lokale evenementen in Overijssel — wij zijn trots op de samenwerking met deze geweldige organisaties en opdrachtgevers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="relaties-grid">
        <div class="relatie-card reveal">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Zwarte-cross.png"
            alt="Zwarte Cross festival — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-1">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Zwarte-cross-4-podiums-invullen-2.png"
            alt="Fresh Enschede — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-2">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/ORANJEPLEIN.png"
            alt="Oranjeplein — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-3">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Oranje-plein-Nijverdal-2.png"
            alt="Oranjeplein Nijverdal — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Paasweekend-Marle.png"
            alt="Paasweekend Marle — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-1">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Deventer-ziekhuis-personeelsfeest.png"
            alt="Deventer Ziekenhuis personeelsfeest — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-2">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Klien-kromhof.png"
            alt="Klein Kromhof — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-3">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/TOi-Toi.jpg"
            alt="Toi Toi — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/KEJA.png"
            alt="KEJA Dronten — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-1">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Roetgerink.png"
            alt="Roetgerink — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-2">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Molke.png"
            alt="De Molke — relatie De Feestmakers"
            loading="lazy"
          />
        </div>

        <div class="relatie-card reveal reveal-delay-3">
          <img
            src="https://defeestmakers.nl/wp-content/uploads/2026/05/Outdoor.png"
            alt="Outdoor evenementen — relatie De Feestmakers"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container reveal" style="position: relative; z-index: 2;">
      <h2 class="display-heading" style="font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 1.5rem;">
        Ook samenwerken<br/><span class="accent">met De Feestmakers?</span>
      </h2>
      <p class="body-text" style="margin: 0 auto 2rem; text-align: center;">
        Wij zijn altijd op zoek naar mooie samenwerkingen. Neem contact op en ontdek wat we voor jouw organisatie kunnen betekenen.
      </p>
      <a href="/contact" class="btn btn-primary btn-arrow">Neem contact op</a>
    </div>
  </section>

</Layout>
