---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Branding & Aankleding Evenementen — De Feestmakers | Event Styling Nijverdal, Overijssel & Nederland"
  description="Event branding en aankleding door De Feestmakers. Van merkbeleving en decoratie tot complete event styling. Evenementenbureau in Nijverdal, actief in Twente, Overijssel en heel Nederland."
  canonical="https://defeestmakers.nl/branding-aankleding"
>

  <section class="page-header">
    <div class="page-header-bg">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/06/Chocomel-Feestmakers.png" alt="Branding en aankleding evenementen — De Feestmakers Nijverdal" loading="eager" />
      <div class="hero-overlay"></div>
    </div>
    <div class="page-header-content">
      <p class="section-label">Branding & Aankleding</p>
      <h1 class="display-heading">Branding &<br/><span class="accent">Aankleding</span></h1>
      <p class="body-text" style="margin-top: 1rem;">Laat jouw merk spreken door het hele event. Van visuele identiteit tot sfeervolle decoratie — alles klopt.</p>
    </div>
  </section>

  <section class="split">
    <div class="split-image">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/06/Sonnema.png" alt="Brand activatie Sonnema — event branding De Feestmakers" loading="lazy" />
    </div>
    <div class="split-content">
      <p class="section-label">Merkbeleving</p>
      <h2 class="section-title">Jouw merk,<br/>tot leven gebracht</h2>
      <p class="body-text">
        Event branding gaat verder dan een logo op een banner. Het is de manier waarop bezoekers jouw merk ervaren op elk moment van het evenement. Bij De Feestmakers vertalen we jouw huisstijl, waarden en boodschap naar een totaalbeleving die consistent en overtuigend is.
      </p>
      <p class="body-text" style="margin-top: 1rem;">
        Van brand activaties voor landelijke merken als Chocomel en Sonnema tot lokale bedrijfsevenementen in Deventer en Almelo — wij zorgen dat jouw branding op elk touchpoint klopt.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="dienst-features reveal" style="max-width: 100%;">
        <div class="dienst-feature">
          <div class="dienst-feature-icon">🎨</div>
          <h4>Visuele Identiteit</h4>
          <p>We vertalen jouw huisstijl naar decor, signing, drukwerk en digitale uitingen voor het evenement.</p>
        </div>
        <div class="dienst-feature">
          <div class="dienst-feature-icon">🪧</div>
          <h4>Signing & Decoratie</h4>
          <p>Van welkomstborden en vlaggen tot op maat gemaakte decor-elementen die jouw merk herkenbaar maken.</p>
        </div>
        <div class="dienst-feature">
          <div class="dienst-feature-icon">🌺</div>
          <h4>Sfeer & Aankleding</h4>
          <p>Tafelaankleding, bloemdecoratie, lichtaccenten en materialen die samen de perfecte sfeer creëren.</p>
        </div>
        <div class="dienst-feature">
          <div class="dienst-feature-icon">📸</div>
          <h4>Instagrammable Moments</h4>
          <p>Photo-spots en visuele highlights die bezoekers zelf willen delen op social media — gratis exposure voor jouw merk.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="photo-grid" style="gap: 4px;">
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/08/Carnaval_Nijverdal_22-02-2025_w-120.jpg" alt="Event aankleding carnaval Nijverdal" loading="lazy" />
    </div>
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/04/DeventerZiekenhuis_17-11-2023_web2-044-3-e1744884388521.jpg" alt="Branding bedrijfsevenement Deventer" loading="lazy" />
    </div>
    <div class="photo-grid-item">
      <img src="https://defeestmakers.nl/wp-content/uploads/2025/11/Feestmakers_14-11-2025_f-80-scaled.jpg" alt="Event decoratie en styling" loading="lazy" />
    </div>
  </div>

  <section class="cta-section">
    <div class="container reveal" style="position: relative; z-index: 2;">
      <h2 class="display-heading" style="font-size: clamp(2.5rem, 6vw, 5rem); margin-bottom: 1.5rem;">
        Jouw merk<br/><span class="accent">verdient het podium</span>
      </h2>
      <p class="body-text" style="margin: 0 auto 2rem; text-align: center;">Laat ons jouw event branding en aankleding verzorgen. Van Nijverdal tot heel Nederland.</p>
      <a href="/contact" class="btn btn-primary btn-arrow">Branding bespreken</a>
    </div>
  </section>

</Layout>
